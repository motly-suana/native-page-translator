{
  "manifest_version": 3,
  "name": "Native Page Translator VI / EN",
  "version": "5.0.0",
  "minimum_chrome_version": "116",
  "description": "Dịch toàn trang VI/EN, viết câu tiếng Anh bản địa & AI Command Center. Hỗ trợ 16+ nhà cung cấp (DeepL, Gemini, Claude, Groq, OpenRouter, DeepSeek, Deploy, OpenAI...) và cân bằng tải multi-key.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api-sf1-cdn.deploy.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://api.mistral.ai/*",
    "https://api.together.xyz/*",
    "https://api.fireworks.ai/*",
    "https://api.perplexity.ai/*",
    "https://api.siliconflow.cn/*",
    "https://api.cohere.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Native Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" }
    },
    "translate-vi": {
      "suggested_key": { "default": "Alt+V" },
      "description": "Dịch trang sang tiếng Việt"
    },
    "translate-en": {
      "suggested_key": { "default": "Alt+E" },
      "description": "Dịch trang sang tiếng Anh"
    },
    "translate-original": {
      "suggested_key": { "default": "Alt+O" },
      "description": "Hiện lại bản gốc"
    },
    "scan-ocr": {
      "description": "Quét chữ trên trang (OCR)"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["icons.js", "fancy-text.js", "glossary.js", "doc-detect.js", "tts.js", "translation-pipeline.js", "ocr-panel.js", "content.js", "qa-solver.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
